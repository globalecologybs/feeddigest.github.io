# Add or merge these keys into your existing _config.yml.
# Anything already present can stay; just make sure the
# plugins block contains all three.

title:       "Global Ecology Digest"
description: "Weekly curated digest of the Bluesky Global Ecology feed: biodiversity, ecosystems, conservation. Terrestrial, freshwater & marine realms."
url:         "https://globalecologybs.github.io"
baseurl:     "/feeddigest.github.io"
lang:        "en_US"
author:
  name:  "Nicolas Mouquet"
  email: "global.ecology.bs@gmail.com"

# Social card image used by jekyll-seo-tag when a page
# doesn't set its own. Per-digest pages override this.
image: https://github.com/globalecologybs/feeddigest.github.io/raw/main/global_ecology.jpg

# Twitter / Bluesky handles for richer cards
twitter:
  card: summary_large_image

# Plugins -- this is the SEO core.
plugins:
  - jekyll-seo-tag    # canonical, OpenGraph, Twitter, JSON-LD
  - jekyll-sitemap    # sitemap.xml
  - jekyll-feed       # /feed.xml RSS

# Feed config
feed:
  path: feed.xml

# Default sitemap behavior; per-page overrides in front matter.
defaults:
  - scope: { path: "" }
    values:
      sitemap:
        changefreq: weekly
        priority: 0.5
